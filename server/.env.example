# Copy to .env and fill in. NEVER commit the real .env.
PORT=8787

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Server-side AI. The key stays on the server and is never exposed to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Postgres connection string (durable storage). Render injects this from the linked database.
# Local dev example: postgres://postgres:postgres@localhost:5432/giraffyreach
DATABASE_URL=

# Public base URL of THIS backend (used to build outreach tracking links).
# e.g. https://giraffyreach.onrender.com  — leave blank to auto-detect from the request.
PUBLIC_URL=
