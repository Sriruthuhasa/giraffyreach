# Copy to .env and fill in. NEVER commit the real .env.
PORT=8787

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Server-side AI. The key stays on the server and is never exposed to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Public base URL of THIS backend (used to build outreach tracking links).
# e.g. https://giraffyreach-api.onrender.com  — leave blank to auto-detect from the request.
PUBLIC_URL=

# Where the SQLite file lives (default: ./giraffyreach.db). On Render, point at a mounted disk.
# DB_PATH=/var/data/giraffyreach.db
